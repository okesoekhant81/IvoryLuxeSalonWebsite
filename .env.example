# Vercel Postgres — from Vercel dashboard: Storage tab > your Postgres db > .env.local tab
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Vercel Blob — from Vercel dashboard: Storage tab > your Blob store > .env.local tab
BLOB_READ_WRITE_TOKEN=

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=
