generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String
  role      String   @default("staff")
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  rating    Int      @default(5)
  body      String
  avatarUrl String?
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceCategory {
  id          String        @id @default(uuid())
  page        String
  title       String
  description String
  order       Int           @default(0)
  items       ServiceItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([page])
}

model ServiceItem {
  id         String          @id @default(uuid())
  categoryId String
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  price      String
  order      Int             @default(0)
}

model SiteContent {
  key   String @id
  value String
}

model Booking {
  id             String   @id @default(uuid())
  name           String
  phone          String
  email          String?
  service        String?
  preferredDate  String?
  preferredTime  String?
  message        String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model RateLimitEntry {
  id        String   @id @default(uuid())
  bucket    String
  ip        String
  createdAt DateTime @default(now())

  @@index([bucket, ip])
}
